{
  "expo": {
    "name": "GrowFarm",
    "slug": "ags-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-ios.png",
    "scheme": "agsmobile",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.progix.agsglobalfarmsarl",
      "buildNumber": "1",
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSLocationWhenInUseUsageDescription": "AGS utilise votre position GPS pour localiser votre ferme avec précision."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/images/app-icon_foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.progix.agsglobalfarmsarl",
      "versionCode": 3,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/app-icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "@rnmapbox/maps"
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AGS utilise votre position GPS pour localiser votre ferme avec précision.",
          "locationAlwaysAndWhenInUsePermission": "AGS utilise votre position GPS pour localiser votre ferme avec précision.",
          "locationAlwaysPermission": "AGS utilise votre position GPS pour localiser votre ferme avec précision."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AGS accède à vos photos pour votre avatar et les photos d'incident.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "AGS utilise Face ID pour protéger votre session."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-web-browser",
      "expo-video",
      "./plugins/withReleaseSigning",
      "./plugins/withDebugSigning"
    ],
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "56b68c06-e0a0-474c-97b8-a6aa8cf71842"
      }
    },
    "owner": "agsglobalfarmsarl"
  }
}
