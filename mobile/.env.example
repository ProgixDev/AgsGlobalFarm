# Backend API (Next.js app). No trailing slash - paths are appended directly.
EXPO_PUBLIC_API_URL=https://www.agsglobalfarm.com

# Mapbox Configuration
# Get your access token from: https://account.mapbox.com/access-tokens/
# Required scopes: Public (default)
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_ACCESS_TOKEN_HERE

# Mapbox Downloads Token (for builds)
# Get your download token from: https://account.mapbox.com/access-tokens/
# Required scopes: DOWNLOADS:READ
# On EAS this must be stored as a secret: eas secret:create --name RNMAPBOX_MAPS_DOWNLOAD_TOKEN
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=YOUR_MAPBOX_DOWNLOAD_TOKEN_HERE

# Android release signing - see mobile/plugins/withReleaseSigning.js
# NOT prefixed EXPO_PUBLIC_: that prefix inlines a value into the client
# bundle, which a signing password must never do.
# STORE_FILE is relative to android/app/. If these are absent, release builds
# fall back to debug signing - the stock template behaviour.
AGS_RELEASE_STORE_FILE=../../keystores/ags-release.jks
AGS_RELEASE_STORE_PASSWORD=
AGS_RELEASE_KEY_ALIAS=ags-release
AGS_RELEASE_KEY_PASSWORD=
