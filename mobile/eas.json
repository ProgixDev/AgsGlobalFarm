{
  "cli": {
    "version": ">= 18.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.agsglobalfarm.com"
      }
    },
    "preview": {
      "extends": "base",
      "ios": {
        "simulator": true,
        "autoIncrement": true
      }
    },
    "production": {
      "extends": "base",
      "ios": {
        "autoIncrement": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
