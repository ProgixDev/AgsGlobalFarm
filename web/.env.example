# mongodb config
MONGODB_URI=
MONGODB_PRIVATEKEY=
MONGODB_PUBLICKEY=

# better-auth config
# Must match the public origin the site is served from (no trailing slash)
BETTER_AUTH_BASE_URL=https://www.agsglobalfarm.com
BETTER_AUTH_SECRET=

# Paydunya Configuration
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_TOKEN=
# test | live
PAYDUNYA_MODE=test

# App Configuration
# Baked into the client bundle at build time - set before building.
NEXT_PUBLIC_APP_URL=https://www.agsglobalfarm.com
STORE_PHONE=
STORE_ADDRESS=
STORE_EMAIL=

# Email via Resend (preferred). When RESEND_API_KEY is set it is used instead of
# SMTP, and EMAIL_FROM_ADDRESS must be on a domain verified in Resend, e.g.
# noreply@agsglobalfarm.com.
RESEND_API_KEY=
# EMAIL_FROM_ADDRESS=noreply@agsglobalfarm.com

# Email Configuration (Nodemailer SMTP fallback, used only without RESEND_API_KEY)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
# Envelope sender shown to recipients. Defaults to EMAIL_USER when unset.
EMAIL_FROM_NAME=AGS Globalfarm SARL
# Only set this once it is a real mailbox or a verified "Send mail as" alias
# on EMAIL_USER - Gmail SMTP rejects an unverified From address.
# EMAIL_FROM_ADDRESS=contact@agsglobalfarm.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=ags/products



R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=agsglobalfarm-videos
R2_PUBLIC_URL=        # fill after Step 5

